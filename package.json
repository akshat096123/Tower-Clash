{
  "name": "tower-clash",
  "version": "1.0.0",
  "private": true,
  "description": "Tower Clash — 3D Tower Defense Strategy Game",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && npm run build:cpp",
    "build:cpp": "make -C cpp",
    "build:vercel": "vite build && (rm -f cpp/build/dsa_engine cpp/build/test_dsa && (command -v g++ >/dev/null 2>&1 && make -C cpp CXX=g++ || (command -v clang++ >/dev/null 2>&1 && make -C cpp CXX=clang++)) || true)",
    "test": "vitest run && npm run test:cpp",
    "test:cpp": "make -C cpp test",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
